<Window
    x:Class="FlowAndroid.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="48,*" Background="Transparent">
        <Grid x:Name="DragRegion" Grid.Row="0" Background="Transparent"
              Padding="20,0,150,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8EA;" FontSize="18" />
                <TextBlock Text="FlowAndroid" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PreviewTag" Text="0.1 · Preview" FontSize="12"
                           Opacity="0.65" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" Background="Transparent"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Left" AlwaysShowHeader="False"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNav" Tag="home" Content="设备">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FirmwareNav" Tag="firmware" Content="刷机向导">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LogsNav" Tag="logs" Content="诊断日志">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutNav" Tag="about" Content="关于">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Spacing="8" Padding="12,4,12,12">
                    <TextBlock x:Name="LanguageCaption" Text="界面语言" Opacity="0.7" FontSize="12"/>
                    <ComboBox x:Name="LanguageSelector" HorizontalAlignment="Stretch"
                              SelectedIndex="0" SelectionChanged="LanguageSelector_SelectionChanged">
                        <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                        <ComboBoxItem Content="日本語" Tag="ja-JP"/>
                        <ComboBoxItem Content="English" Tag="en-US"/>
                    </ComboBox>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid Padding="30,16,30,30">
                <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" MaxWidth="920" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="HomeTitle" Text="我的设备"
                                       FontSize="30" FontWeight="SemiBold" />
                            <TextBlock x:Name="HomeDescription" Text="通过 USB 连接 Google Pixel，检查 ADB 与 Fastboot。"
                                       TextWrapping="Wrap" Opacity="0.75"/>
                        </StackPanel>
                        <InfoBar x:Name="SafetyBanner" IsOpen="True" IsClosable="False"
                                 Severity="Informational" Title="安全预览"
                                 Message="本版本只检测设备和 OTA 兼容性，不会执行刷写、解锁或清除数据。" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="18">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8EA;" FontSize="32" VerticalAlignment="Center"/>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="DeviceHeading" Text="设备状态" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DeviceSummary" Text="尚未扫描" TextWrapping="Wrap" Opacity="0.75"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="ModelCaption" Text="机型" Opacity="0.65"/>
                                        <TextBlock x:Name="ModelValue" Text="—" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CodeCaption" Text="硬件代号" Opacity="0.65"/>
                                        <TextBlock x:Name="CodeValue" Text="—" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock x:Name="StateCaption" Text="连接状态" Opacity="0.65"/>
                                        <TextBlock x:Name="StateValue" Text="—" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="VersionCaption" Text="Android 版本" Opacity="0.65"/>
                                        <TextBlock x:Name="VersionValue" Text="—" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BatteryCaption" Text="电量" Opacity="0.65"/>
                                        <TextBlock x:Name="BatteryValue" Text="—" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ToolStatus" Text="ADB / Fastboot：待检测"
                                           TextWrapping="Wrap" Opacity="0.7"/>
                                <HyperlinkButton x:Name="PlatformToolsLink" Content="下载 Google 官方 Platform-Tools"
                                    NavigateUri="https://developer.android.com/tools/releases/platform-tools"
                                    Padding="0" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Button x:Name="ScanButton" Content="扫描设备" Style="{StaticResource AccentButtonStyle}"
                                            Click="ScanButton_Click"/>
                                    <ProgressRing x:Name="ScanProgress" IsActive="False" Width="22" Height="22"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="NextStepTitle" Text="接下来" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NextStepBody" Text="识别设备后，在 OTA 固件页面选择 ZIP，并执行兼容性预检。"
                                           TextWrapping="Wrap" Opacity="0.78"/>
                                <Button x:Name="OpenFirmwareButton" Content="选择 OTA 固件"
                                        HorizontalAlignment="Left" Click="OpenFirmwareButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="FirmwarePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" MaxWidth="920">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="FirmwareTitle" Text="Pixel 更新与恢复向导"
                                       FontSize="30" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FirmwareDescription" Text="按照步骤连接设备、选择官方 OTA、校验固件、在 Recovery 中更新并验证安装结果。"
                                       TextWrapping="Wrap" Opacity="0.75"/>
                        </StackPanel>
                        <InfoBar x:Name="WizardInfo" IsOpen="True" IsClosable="False"
                                 Severity="Informational" Title="官方 OTA 更新 · 新手引导"
                                 Message="无需解锁 Bootloader，通常不会抹除数据。只推荐识别到的稳定版；机型、变体或版本有疑点时不自动选择。" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="WizardStep1Title" Text="① 连接并识别 Pixel"
                                           FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WizardStep1Help"
                                           Text="打开手机的开发者选项和 USB 调试，用数据线连接电脑，并在手机上允许此电脑的调试请求。"
                                           TextWrapping="Wrap" Opacity="0.76"/>
                                <TextBlock x:Name="WizardDeviceStatus" Text="尚未连接 Pixel。"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button x:Name="WizardScanButton" Content="自动检查连接" Click="WizardScan_Click"/>
                                    <Button x:Name="WizardDemoButton" Content="无手机？先预览步骤" Click="WizardDemo_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="WizardDemoText" Visibility="Collapsed"
                                           TextWrapping="Wrap" Opacity="0.7"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="WizardStep2Title" Text="② 选择 Google 官方完整 OTA"
                                           FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WizardStep2Help"
                                           Text="读取官方目录，只显示与你的 Pixel 代号匹配的稳定版。发现同日多个地区变体时停止自动推荐。"
                                           TextWrapping="Wrap" Opacity="0.76"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="WizardFindButton" Content="自动查找适配固件"
                                            Click="WizardFind_Click"/>
                                    <ProgressRing x:Name="WizardFindProgress" Width="22" Height="22" IsActive="False"/>
                                </StackPanel>
                                <TextBlock x:Name="WizardChoiceStatus" Text="连接手机后可自动查找。"
                                           TextWrapping="Wrap"/>
                                <ComboBox x:Name="WizardCandidateCombo" Header="官方目录中的稳定版候选"
                                          HorizontalAlignment="Stretch" IsEnabled="False"
                                          SelectionChanged="WizardCandidate_SelectionChanged"/>
                                <TextBlock x:Name="WizardDownloadNote" Text="将保存到用户本地固件缓存；只在与 Google 公布的 SHA-256 完全一致时接受。"
                                           TextWrapping="Wrap" Opacity="0.7"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button x:Name="WizardDownloadButton" Content="下载并自动校验"
                                            IsEnabled="False" Click="WizardDownload_Click"/>
                                    <Button x:Name="WizardCancelButton" Content="取消下载"
                                            Visibility="Collapsed" Click="WizardCancel_Click"/>
                                </StackPanel>
                                <ProgressBar x:Name="WizardDownloadProgress" Minimum="0" Maximum="100"
                                             Value="0" Visibility="Collapsed" Height="5"/>
                                <TextBlock x:Name="WizardDownloadStatus" Text="尚未下载。"
                                           TextWrapping="Wrap"/>
                                <HyperlinkButton x:Name="WizardOfficialLink" Content="在 Google 官网检查所有版本及地区说明"
                                    NavigateUri="https://developers.google.com/android/ota" Padding="0"
                                    HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="16">
                                <TextBlock x:Name="PackageTitle" Text="③ 校验已下载或本地固件" FontSize="20" FontWeight="SemiBold"/>
                                <Button x:Name="PickPackageButton" Content="浏览本地 ZIP…" HorizontalAlignment="Left"
                                        Click="PickPackageButton_Click"/>
                                <ProgressRing x:Name="PackageProgress" IsActive="False" Height="22" Width="22" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="PackageName" Text="尚未选择" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PackageCode" Text="目标设备：—" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PackageType" Text="OTA 类型：—" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PackageBuild" Text="目标版本：—" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PackageHash" Text="SHA-256：—" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="PreflightTitle" Text="④ 检查风险、进入 Recovery 与传输" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PreflightResult" Text="先扫描设备并选择固件。" TextWrapping="Wrap"/>
                                <Button x:Name="PreflightButton" Content="重新检查兼容性" HorizontalAlignment="Left"
                                        Click="PreflightButton_Click"/>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,4"/>
                                <TextBlock x:Name="OfficialTitle" Text="核验 Google 官方校验值"
                                           FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Name="OfficialHint"
                                           Text="连接互联网读取 Google 官方 OTA 页面，核对 ZIP 文件名与 SHA-256。"
                                           TextWrapping="Wrap" Opacity="0.72"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="VerifyOfficialButton" Content="在线核验固件"
                                            Click="VerifyOfficial_Click"/>
                                    <ProgressRing x:Name="OfficialProgress" Width="22" Height="22" IsActive="False"/>
                                </StackPanel>
                                <TextBlock x:Name="OfficialResult" Text="尚未核验" TextWrapping="Wrap"/>
                                <HyperlinkButton Content="Google 官方完整 OTA 列表"
                                    NavigateUri="https://developers.google.com/android/ota" Padding="0"/>
                                <TextBlock x:Name="SideloadTitle" Text="Recovery 操作说明"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SideloadInstructions"
                                           Text="步骤：手机保持连接 → 通过按键进入 Recovery → 如出现红色感叹号，按住电源并点按音量上 → 选择 Apply update from ADB → 回到电脑确认传输。手机操作完毕后才允许开始。"
                                           TextWrapping="Wrap"/>
                                <CheckBox x:Name="BackupConsent" Content="我已备份需要保留的数据"
                                          Checked="OtaConsentChanged" Unchecked="OtaConsentChanged"/>
                                <CheckBox x:Name="TermsConsent" Content="我已阅读并接受 Google 固件使用条款"
                                          Checked="OtaConsentChanged" Unchecked="OtaConsentChanged"/>
                                <Button x:Name="EnterRecoveryButton" Content="一键进入 Recovery"
                                        IsEnabled="False" HorizontalAlignment="Left" Click="EnterRecovery_Click"/>
                                <TextBlock x:Name="RecoveryStatusText" Text="手机重启到 Recovery 后，如见红色感叹号，请按住电源并点按音量上；随后选择 Apply update from ADB。"
                                           TextWrapping="Wrap" Opacity="0.7"/>
                                <CheckBox x:Name="RecoveryConsent" Content="手机已经进入 Apply update from ADB 界面"
                                          Checked="OtaConsentChanged" Unchecked="OtaConsentChanged"/>
                                <Button x:Name="StartSideloadButton" Content="验证后开始 OTA 传输"
                                        IsEnabled="False" HorizontalAlignment="Left" Click="StartSideload_Click"/>
                                <ProgressRing x:Name="SideloadActivity" Width="26" Height="26"
                                              IsActive="False" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="SideloadStatus" Text="传输完成后仍需在手机 Recovery 屏幕确认安装结果。"
                                           TextWrapping="Wrap" Opacity="0.72"/>
                                <Button x:Name="VerifyPostInstallButton" Content="重启后验证系统版本"
                                        HorizontalAlignment="Left" IsEnabled="False" Click="VerifyPostInstall_Click"/>
                                <InfoBar x:Name="ProvenanceWarning" IsOpen="True" IsClosable="False"
                                         Severity="Warning" Title="未验证固件来源"
                                         Message="本地 SHA-256 仅提供文件指纹，不代表已经验证 Google 签名。此版本不会写入设备。"/>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="AdvancedFactoryExpander"
                                  Header="高级工具（仅做检查）" IsExpanded="False">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="FactoryTitle" Text="高级：Factory Image（仅检查，不执行刷写）"
                                           FontWeight="SemiBold" FontSize="20"/>
                                <TextBlock x:Name="FactoryWarning"
                                           Text="Factory Image 可能清除所有个人数据，且存在反回滚限制。当前提供官方 SHA-256、压缩包结构和设备代号检查，禁用自动分区刷写。"
                                           TextWrapping="Wrap"/>
                                <Button x:Name="PickFactoryButton" Content="检查 Factory Image ZIP…"
                                        HorizontalAlignment="Left" Click="PickFactory_Click"/>
                                <TextBlock x:Name="FactoryResult" Text="尚未选择出厂映像。" TextWrapping="Wrap"/>
                                <HyperlinkButton Content="Google 官方出厂映像列表" Padding="0"
                                    NavigateUri="https://developers.google.com/android/images"/>
                            </StackPanel>
                        </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="LogsPanel" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="920">
                        <TextBlock x:Name="LogsTitle" Text="诊断日志" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LogsDescription" Text="日志仅保留在当前应用会话，分享前请遮盖设备序列号和文件路径。"
                                   TextWrapping="Wrap" Opacity="0.72"/>
                        <TextBox x:Name="LogsText" TextWrapping="Wrap" IsReadOnly="True"
                                 AcceptsReturn="True" Height="430"/>
                        <Button x:Name="ClearLogsButton" Content="清空日志" HorizontalAlignment="Left" Click="ClearLogsButton_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="920">
                        <TextBlock Text="FlowAndroid" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AboutVersion" Text="0.1.0 · Diagnostic preview" Opacity="0.75"/>
                        <TextBlock x:Name="AboutDescription" Text="面向 Pixel 的 Windows 原生 Android 维护工具。"
                                   TextWrapping="Wrap"/>
                        <HyperlinkButton Content="GitHub · KiYouJyo/FlowAndroid"
                                         NavigateUri="https://github.com/KiYouJyo/FlowAndroid"/>
                        <TextBlock Text="© 2026 KiYouJyo · MIT" Opacity="0.6"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
